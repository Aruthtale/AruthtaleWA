[Unit]
Description=Arverz - AI Linux Automation Assistant
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/App&Bot/Arverz
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
# Set low priority to avoid affecting laptop performance
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=default.target
