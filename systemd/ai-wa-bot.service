[Unit]
Description=AI WhatsApp Bot - Linux Automation Assistant
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/ai-wa-bot
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
# Set low priority to avoid affecting laptop performance
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=default.target
