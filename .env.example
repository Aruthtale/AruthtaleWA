# --- WHATSAPP CONFIG ---
# Nomor owner tanpa @s.whatsapp.net (contoh: 628123456789)
OWNER_NUMBER=your_number_here
# Prefix perintah bot (contoh: !)
PREFIX=!

# --- AI API KEYS ---
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_KEY=your_gemini_key_here

# OpenRouter (Fallback): https://openrouter.ai/keys
OPENROUTER_KEY=your_openrouter_key_here

# --- SPOTIFY CLOUD API (Optional) ---
# Spotify Dashboard: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_id
SPOTIFY_CLIENT_SECRET=your_spotify_secret

# --- OTHER CONFIG ---
# Pilih browser untuk cookies (chrome/firefox/edge)
BROWSER_COOKIES=chrome
# Path manual ke file cookies.txt (jika ada)
COOKIES_PATH=./cookies.txt

# --- SUPABASE CONFIG ---
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# --- REPLICATE API KEY (HD Upscaler) ---
# Replicate Dashboard: https://replicate.com/
REPLICATE_API_TOKEN=your_replicate_token_here

